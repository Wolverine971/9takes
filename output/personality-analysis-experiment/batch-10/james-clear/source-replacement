<script>
jQuery(document).ready(function($){

    $(document).off('click.tocScroll');

    $(document).on('click.tocScroll', '.table-of-contents a', function(e){

        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        var targetID = $(this).attr('href');

        if (!targetID || targetID === '#') return;

        var target = $(targetID);

        if (target.length) {

            $('html, body').stop(true).animate({
                scrollTop: target.offset().top - 155
            }, 500);

        }

        return false;
    });

});
</script>



