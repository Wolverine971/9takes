round{background: var(--wp--preset--gradient--very-light-gray-to-cyan-bluish-gray) !important;}.has-cool-to-warm-spectrum-gradient-background{background: var(--wp--preset--gradient--cool-to-warm-spectrum) !important;}.has-blush-light-purple-gradient-background{background: var(--wp--preset--gradient--blush-light-purple) !important;}.has-blush-bordeaux-gradient-background{background: var(--wp--preset--gradient--blush-bordeaux) !important;}.has-luminous-dusk-gradient-background{background: var(--wp--preset--gradient--luminous-dusk) !important;}.has-pale-ocean-gradient-background{background: var(--wp--preset--gradient--pale-ocean) !important;}.has-electric-grass-gradient-background{background: var(--wp--preset--gradient--electric-grass) !important;}.has-midnight-gradient-background{background: var(--wp--preset--gradient--midnight) !important;}.has-black-tran-right-gradient-background{background: var(--wp--preset--gradient--black-tran-right) !important;}.has-small-font-size{font-size: var(--wp--preset--font-size--small) !important;}.has-medium-font-size{font-size: var(--wp--preset--font-size--medium) !important;}.has-large-font-size{font-size: var(--wp--preset--font-size--large) !important;}.has-x-large-font-size{font-size: var(--wp--preset--font-size--x-large) !important;}.has-d-3-font-size{font-size: var(--wp--preset--font-size--d-3) !important;}.has-d-2-font-size{font-size: var(--wp--preset--font-size--d-2) !important;}.has-d-1-font-size{font-size: var(--wp--preset--font-size--d-1) !important;}.has-h-1-font-size{font-size: var(--wp--preset--font-size--h-1) !important;}.has-h-2-font-size{font-size: var(--wp--preset--font-size--h-2) !important;}.has-h-3-font-size{font-size: var(--wp--preset--font-size--h-3) !important;}.has-h-4-font-size{font-size: var(--wp--preset--font-size--h-4) !important;}.has-h-5-font-size{font-size: var(--wp--preset--font-size--h-5) !important;}.has-plg-font-size{font-size: var(--wp--preset--font-size--plg) !important;}.has-sm-font-size{font-size: var(--wp--preset--font-size--sm) !important;}.has-xs-font-size{font-size: var(--wp--preset--font-size--xs) !important;}.has-2-xs-font-size{font-size: var(--wp--preset--font-size--2-xs) !important;}.has-3-xs-font-size{font-size: var(--wp--preset--font-size--3-xs) !important;}.has-sans-serif-font-family{font-family: var(--wp--preset--font-family--sans-serif) !important;}.has-serif-font-family{font-family: var(--wp--preset--font-family--serif) !important;}/* Styles for floated images to fill screen on mobile devices (phones) */
@media only screen and (max-width: 440px) {
  .is-layout-constrained > .alignleft {
    margin-inline-end: 0 !important;
  }
  .is-layout-constrained > .alignright {
     margin-inline-start: 0 !important;
  }
  .fullMobileImg > figure {
    min-width:100% !important;
  }
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--wp--preset--font-family--serif);
  font-weight:500;
}

.ut-external-source {
  font-weight:500;
  text-transform:none;
  letter-spacing: 0;
}

a {
  text-decoration-thickness: 2px !important;
  /* Adjust weight here */
  text-underline-offset: 4px;
}

.wp-block-gallery.has-nested-images figure.wp-block-image figcaption {
background: linear-gradient(0deg,#0009,#0000);
}
.ut-post-author.align.wp-block-ut-post-author {
    text-decoration: none;
}

/* Resize the UT News Masthead */
@media (min-width: 900px) {
/* Adding Line details to the Masthead */
  .site-header__logo-wrap {
    padding-bottom: 2px !important;
    padding-top: 4px !important;
    border-bottom: 2px solid #D6D2C4;
    margin-bottom: 2px !important;
  }
  .site-header__top {
    border-bottom: 1px solid #D6D2C4;
    background:#fff !important;
  }
  .nav-main {
    border-top: 1px solid #D6D2C4;
  }
  .nav-main__list {
    padding: .5rem var(--container-padding) .5rem !important;
  }
  .nav-main__topic-list {
    padding: 1.2em var(--container-padding) 1em  var(--container-padding) !important;
  }
/* change size of UT NEWS on scroll */
  .header-sm .site-header__logo {
    width: 12rem !important;
  }
}

/* Burnt Orange utility bar styles */
.site-header__top {
    background: var(--wp--preset--color--burnt-orange)!important;
}
span.site-header__date {
    color: #FFF !important;
}

/* Hover state for buttons */
.wp-block-button__link:hover, .wp-block-button:hover {
  border-radius:4px;    
  background-color: #9E4800 !important; 
}

.all-news-link a {
  text-decoration:none !important;
}
.all-news-link a:hover {
  text-decoration:underline !important;
}


