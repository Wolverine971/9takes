{
	"name": "9takes",
	"version": "0.0.1",
	"packageManager": "pnpm@11.7.0",
	"scripts": {
		"dev": "node --max-http-header-size=65536 ./node_modules/vite/bin/vite.js dev",
		"prebuild": "pnpm run check:budgets:static",
		"build": "vite build && node scripts/check-build-budgets.mjs",
		"build:vercel": "pnpm run gen:personality-image-map && pnpm run gen:famous-types && pnpm run gen:corpus-stats && pnpm run gen:sitemap && pnpm run gen:llms && pnpm run build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"test": "vitest --run",
		"all:install": "pnpm -w i --filter=\"*\"",
		"all:build": "pnpm -w exec nx run-many --target=build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:budgets": "node scripts/check-build-budgets.mjs",
		"check:budgets:static": "node scripts/check-build-budgets.mjs --static-only",
		"budgets:accept-portraits": "node scripts/check-build-budgets.mjs --accept-portrait-baseline",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"lint": "prettier --check . && eslint . && node scripts/lint-radius.js && node scripts/lint-retired-color-tokens.mjs && node scripts/lint-global-component-css.mjs",
		"lint:radius": "node scripts/lint-radius.js",
		"lint:colors": "node scripts/lint-retired-color-tokens.mjs",
		"lint:global-css": "node scripts/lint-global-component-css.mjs",
		"format": "prettier --write .",
		"format:transcripts": "prettier --ignore-path /dev/null --write youtube-transcript-research youtube-transcripts-people",
		"clean": "rimraf .svelte-kit",
		"gen:sctx": "tsx scripts/generateStreamlinedProjectContext2.ts . -o docs/archives/sproject-context.json",
		"label-paths": "tsx scripts/labelFilePaths.ts",
		"gen:types": "node scripts/generate-types.js",
		"gen:brand-icons": "node scripts/generate-brand-icons.mjs",
		"gen:personality-image-map": "node scripts/generate-personality-image-slug-map.js",
		"portrait:check": "node scripts/check-personality-portrait.mjs",
		"gen:sitemap": "node scripts/generate-sitemap.js",
		"gen:llms": "node scripts/generate-llms.js",
		"gen:famous-types": "node scripts/generate-famous-types.js",
		"gen:corpus-stats": "node scripts/generate-corpus-stats.js",
		"gen:instagram-plan": "node --import tsx scripts/build-instagram-posting-plan.ts",
		"marketing:queue": "node scripts/check-marketing-content-queue.mjs",
		"gen:crosslinks": "node scripts/generate-crosslink-report.js",
		"gen:search-index": "node scripts/index-blogs-to-supabase.js --if-env",
		"gen:all": "node scripts/gen-all.js",
		"gen:all:full": "node scripts/gen-all.js --all",
		"index:blogs": "node scripts/index-blogs-to-supabase.js",
		"index:blogs:dry": "node scripts/index-blogs-to-supabase.js --dry-run",
		"index:blogs:force": "node scripts/index-blogs-to-supabase.js --force",
		"push:people": "node scripts/personBlogParser.js",
		"gen:chorus": "node scripts/generate-chorus.mjs",
		"gen:chorus:force": "node scripts/generate-chorus.mjs --force",
		"regen:takes": "node --import tsx scripts/regen-nine-takes.ts",
		"audit:people-seo": "node scripts/audit-people-seo.js",
		"audit:people-corpus": "node scripts/people-corpus-audit.mjs",
		"audit:people-crosslinks": "node scripts/audit-people-crosslinks.mjs --write",
		"audit:internal-anchors": "node scripts/audit-internal-anchor-text.mjs --write",
		"audit:blog-enrichment": "node scripts/blog-enrichment-status.mjs",
		"supabase:normalize-personality-slugs": "node scripts/normalize-personality-slugs.js",
		"seo:normalize-internal-personality-links": "node scripts/normalize-internal-personality-links.js",
		"test:smoke": "playwright test",
		"audit:security": "pnpm audit --audit-level=low"
	},
	"devDependencies": {
		"@babel/parser": "^7.27.4",
		"@babel/traverse": "^7.27.4",
		"@babel/types": "^7.27.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/enhanced-img": "^0.9.2",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3": "^7.4.3",
		"@types/gtag.js": "^0.0.20",
		"@types/pluralize": "^0.0.33",
		"@types/qrcode": "^1.5.6",
		"@types/sanitize-html": "2.16.1",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"autoprefixer": "^10.5.4",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-glob": "^3.3.3",
		"flowbite": "^2.5.1",
		"jsdom": "^29.1.1",
		"mdsvex": "^0.12.8",
		"postcss": "^8.5.26",
		"postcss-load-config": "^4.0.2",
		"postcss-preset-env": "^7.8.3",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass": "^1.103.1",
		"supabase": "2.116.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-preprocess": "^6.0.5",
		"tailwindcss": "^3.4.9",
		"tslib": "^2.7.0",
		"tsx": "^4.23.13",
		"typescript": "^5.9.2",
		"vite": "^7.3.5",
		"vitest": "^4.1.11"
	},
	"browser": {
		"crypto": false
	},
	"type": "module",
	"engines": {
		"node": ">=22.13.0 <25",
		"pnpm": ">=11.7.0 <12"
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.8",
		"@elastic/elasticsearch": "^8.15.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.39.0",
		"@supabase/ssr": "0.12.5",
		"@supabase/supabase-js": "2.114.0",
		"axios": "^1.20.0",
		"cheerio": "^1.2.0",
		"d3": "^7.9.0",
		"d3-cloud": "^1.2.9",
		"dotenv": "^16.4.5",
		"googleapis": "^173.0.0",
		"gray-matter": "^4.0.3",
		"html-to-image": "^1.11.11",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.2.1",
		"marked": "^16.2.0",
		"opentype.js": "^2.0.0",
		"pluralize": "^8.0.0",
		"postcss-scss": "^4.0.9",
		"posthog-js": "^1.425.1",
		"qrcode": "^1.5.4",
		"rehype-slug": "^5.1.0",
		"remark-abbr": "^1.4.2",
		"remark-github": "^11.2.4",
		"resend": "6.25.0",
		"sanitize-html": "2.17.7",
		"sharp": "0.35.4",
		"stemmer": "^2.0.1",
		"stripe": "^11.18.0",
		"uuid": "^11.1.1",
		"web-vitals": "^3.5.2",
		"zod": "^3.25.76"
	}
}
